index 41f4881..5948098 100644
--- a/sdk/src/CMakeLists.txt
+++ b/sdk/src/CMakeLists.txt
@@ -1,6 +1,14 @@
 # Copyright The OpenTelemetry Authors
 # SPDX-License-Identifier: Apache-2.0
 
+# ===== Patch: skip the configuration component when exception handling is disabled =====
+# The configuration component always uses throw/catch and can not be compiled with -fno-exceptions.
+include(CheckCXXSourceCompiles)
+check_cxx_source_compiles("int main() { throw 1; return 0; }" OTELCPP_CONFIGURATION_HAVE_EXCEPTIONS)
+if(NOT OTELCPP_CONFIGURATION_HAVE_EXCEPTIONS)
+  message(STATUS "Exception handling is disabled, skip building the configuration component")
+endif()
