diff --git a/lib/tls/CMakeLists.txt b/lib/tls/CMakeLists.txt
index b51fa3e..beef5d0 100644
--- a/lib/tls/CMakeLists.txt
+++ b/lib/tls/CMakeLists.txt
@@ -505,6 +505,14 @@ if (LWS_WITH_SSL)
 				find_package(PkgConfig QUIET)
 				pkg_check_modules(PC_OPENSSL openssl QUIET)
 				find_package(OpenSSL)
+				if(TARGET OpenSSL::SSL OR TARGET OpenSSL::Crypto)
+					if(TARGET OpenSSL::SSL AND NOT "OpenSSL::SSL" IN_LIST OPENSSL_LIBRARIES)
+						list(APPEND OPENSSL_LIBRARIES OpenSSL::SSL)
+					endif()
+					if(TARGET OpenSSL::Crypto AND NOT "OpenSSL::Crypto" IN_LIST OPENSSL_LIBRARIES)
+						list(APPEND OPENSSL_LIBRARIES OpenSSL::Crypto)
+					endif()
+				endif()
 				if (NOT OPENSSL_FOUND)
 					message(FATAL_ERROR "OpenSSL development packages (e.g., libssl-dev or openssl-devel) not found! \\nIf you want to use OpenSSL, please install them.\\nIf you installed GnuTLS instead, you must explicitly enable it by adding -DLWS_WITH_GNUTLS=1 to your cmake line.\\nYou can also disable SSL completely with -DLWS_WITH_SSL=0.")
 				endif()
