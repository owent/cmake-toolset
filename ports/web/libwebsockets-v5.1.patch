diff --git a/lib/plat/unix/CMakeLists.txt b/lib/plat/unix/CMakeLists.txt
index 18ecece..8494ede 100644
--- a/lib/plat/unix/CMakeLists.txt
+++ b/lib/plat/unix/CMakeLists.txt
@@ -73,10 +73,21 @@ if (LWS_WITH_NETWORK)
 				# too.  CoreFoundation is needed directly (not just
 				# via SystemConfiguration) for our own CF references.
 				find_library(LWS_SYSCONFIG_FW NAMES SystemConfiguration)
+				if (NOT LWS_SYSCONFIG_FW)
+					# ===== Patch: restricted find modes (CMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY with
+					# ===== a third party prefix as the only root) hide the system frameworks, retry
+					# ===== with the default paths. =====
+					find_library(LWS_SYSCONFIG_FW NAMES SystemConfiguration
+						     NO_CMAKE_FIND_ROOT_PATH)
+				endif()
 				if (NOT LWS_SYSCONFIG_FW)
 					message(FATAL_ERROR "SystemConfiguration framework not found")
 				endif()
 				find_library(LWS_COREFOUNDATION_FW NAMES CoreFoundation)
+				if (NOT LWS_COREFOUNDATION_FW)
+					find_library(LWS_COREFOUNDATION_FW NAMES CoreFoundation
+						     NO_CMAKE_FIND_ROOT_PATH)
+				endif()
 				if (NOT LWS_COREFOUNDATION_FW)
 					message(FATAL_ERROR "CoreFoundation framework not found")
 				endif()
