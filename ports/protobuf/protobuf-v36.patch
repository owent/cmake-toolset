 )
 if (protobuf_BUILD_LIBUPB)
-  list(APPEND protobuf_HEADERS ${libupb_hdrs})
+  # ===== Patch: do not install the upb headers into the shared prefix. gRPC's SSL provider
+  # ===== package also lives in the prefix, and gRPC puts the prefix's include directory before
+  # ===== its own vendored upb headers, so protobuf's upb headers would shadow gRPC's vendored
